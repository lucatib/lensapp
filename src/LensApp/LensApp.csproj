<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>LensApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <ApplicationTitle>LensApp</ApplicationTitle>
    <ApplicationId>com.qbtapp.lensapp</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon / splash -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0E1116" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0E1116" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- CameraX, pinned for reproducible restores. -->
    <PackageReference Include="Xamarin.AndroidX.Camera.Core" Version="1.6.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.6.1.1" />

    <!--
      Maui.Controls transitively references AndroidX.Navigation 2.9.2.1, whose Ktx bindings
      (Fragment.Ktx, Activity.Ktx, etc.) declare narrow version ranges tied to the AndroidX base
      packages of that same release. CameraX.View needs newer base packages (Fragment 1.8.9.3+,
      Core 1.19.0.1+, ...), which pushes the resolved versions outside those ranges and NuGet
      raises NU1608. Bumping Navigation.Fragment/.Runtime.Android to the latest release realigns
      their Ktx bindings with the versions CameraX already pulls in, closing most of the gap.
      Navigation.UI is left at 2.9.2.1 on purpose: bumping it drags in a newer Material Components
      binding whose Slider listener interfaces changed shape and breaks the generated Java glue
      (BaseOnChangeListenerImplementor/BaseOnSliderTouchListenerImplementor). That leaves two
      harmless NU1608s (Navigation.UI -> Navigation.Common/.Runtime) unresolved.
    -->
    <PackageReference Include="Xamarin.AndroidX.Navigation.Fragment" Version="2.9.8.1" />
    <PackageReference Include="Xamarin.AndroidX.Navigation.Runtime.Android" Version="2.9.8.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
  </ItemGroup>


  <!-- ============================ release size ============================ -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- MAUI ships a partial trim by default; full drops the framework surface this app never calls. -->
    <TrimMode>full</TrimMode>

    <!-- Feature switches for machinery LensApp does not use. UseSystemResourceKeys collapses
         framework exception messages to resource ids, so release crash logs read as keys. -->
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <NullabilityInfoContextSupport>false</NullabilityInfoContextSupport>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- .NET Android leaves both R8 shrinkers off by default, so the Java side (MAUI, AndroidX,
         CameraX, Kotlin) shipped whole. dex goes to every device regardless of ABI, so on Play
         it is the download, not the native libs Play already splits per device. -->
    <AndroidLinkTool>r8</AndroidLinkTool>
    <AndroidLinkResources>true</AndroidLinkResources>

    <!-- Profiled AOT is already on in Release; without this the IL rides along next to it. -->
    <AndroidStripILAfterAOT>true</AndroidStripILAfterAOT>
  </PropertyGroup>


  <!-- ============================ release signing ============================ -->
  <!--
    Play App Signing means this is the *upload* key - Google holds the app signing key itself.
    The keystore lives outside the repo and all three secrets come from the environment, so
    nothing signable is committable and no password lands in shell history:

      setx LENSAPP_KEYSTORE      "%USERPROFILE%\keys\lensapp-upload.jks"
      setx LENSAPP_KEYSTORE_PASS "..."
      setx LENSAPP_KEY_PASS      "..."

    versionCode is ApplicationVersion above: Play needs it unique and increasing per upload,
    so bump it by hand for every release. ApplicationDisplayVersion is the human-facing one.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'
                            And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'
                            And '$(LENSAPP_KEYSTORE)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(LENSAPP_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>lensapp-upload</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>$(LENSAPP_KEYSTORE_PASS)</AndroidSigningStorePass>
    <AndroidSigningKeyPass>$(LENSAPP_KEY_PASS)</AndroidSigningKeyPass>
  </PropertyGroup>

  <!-- Fail loudly rather than quietly handing back a debug-signed package that Play will reject. -->
  <Target Name="_LensAppRequireUploadKey"
          BeforeTargets="_Sign"
          Condition="'$(Configuration)' == 'Release'
                     And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'
                     And '$(LENSAPP_KEYSTORE)' == ''">
    <Error Code="LENS001"
           Text="Release Android packages must be signed with the Play upload key, but LENSAPP_KEYSTORE is not set. Set LENSAPP_KEYSTORE (full path to lensapp-upload.jks), LENSAPP_KEYSTORE_PASS and LENSAPP_KEY_PASS in the environment and reopen the shell. Without them the package is signed with the Android debug key, which Play rejects." />
  </Target>

</Project>
